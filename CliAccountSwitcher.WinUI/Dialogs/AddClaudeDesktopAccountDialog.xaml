<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="CliAccountSwitcher.WinUI.Dialogs.AddClaudeDesktopAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CliAccountSwitcher.WinUI.ViewModels"
    x:Uid="AddClaudeDesktopAccountDialog"
    Closing="OnAddClaudeDesktopAccountDialogClosing"
    DefaultButton="Close"
    Opened="OnAddClaudeDesktopAccountDialogOpened"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid Width="600" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="AddClaudeDesktopAccountDialog_DescriptionTextBlock"
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Uid="AddClaudeDesktopAccountDialog_AccountsHeaderTextBlock"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <ProgressRing
                    x:Name="LoadingProgressRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
            </StackPanel>

            <ListView
                x:Name="AccountsListView"
                MaxHeight="300"
                SelectionChanged="OnAccountsListViewSelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ClaudeDesktopAccountCandidateViewModel">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind EmailAddress}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind OrganizationName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="10"
                                Visibility="{x:Bind IsDesktopCurrentAccount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    x:Uid="AddClaudeDesktopAccountDialog_CurrentAccountTextBlock"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyStateTextBlock"
                x:Uid="AddClaudeDesktopAccountDialog_EmptyStateTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <TextBlock
            x:Uid="AddClaudeDesktopAccountDialog_ReadOnlyNoticeTextBlock"
            Grid.Row="2"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="ImportButton"
                Click="OnImportButtonClicked"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    <TextBlock x:Uid="AddClaudeDesktopAccountDialog_ImportButtonTextBlock" />
                </StackPanel>
            </Button>
            <ProgressRing
                x:Name="ImportProgressRing"
                Width="24"
                Height="24"
                IsActive="False"
                Visibility="Collapsed" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="4"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</ContentDialog>
